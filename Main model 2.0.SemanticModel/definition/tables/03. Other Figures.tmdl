	measure 'Diff Actuals dynamic' =
			
			SWITCH(
			    TRUE(),
			    MAX('00. DateTable'[Date]) > TODAY(), BLANK(),
			    [Actuals] - 'Z. Figure Selector'[Figure dynamic])
		formatString: #,0
		lineageTag: 7baa690b-f3dd-45f5-b74a-f18317c2fecb

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '% Diff Actuals dynamic' =
			
			SWITCH(
			    TRUE(),
			    MAX('00. DateTable'[Date]) > TODAY(), BLANK(),
			    DIVIDE([Actuals] - 'Z. Figure Selector'[Figure dynamic],[Actuals]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: a710ab9c-f814-4141-8e69-6d663fcbdc4a

	measure 'Actuals & Future' =
			
			CALCULATE(
			    SWITCH(
			        TRUE(),
			        MAX('00. DateTable'[Date]) > TODAY(), 'Z. Figure Selector'[Figure dynamic],
			        [Actuals]
			    ),
			    VALUES('00. DateTable'[Date])
			)
		formatString: #,0
		lineageTag: da208612-3f57-446a-be9d-7c37b6094200

		annotation PBI_FormatHint = {"isDecimal":true}

