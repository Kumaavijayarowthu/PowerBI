	measure 'PL Front Color' =
			
			SWITCH(
			    TRUE(),
			    MAX('P&L Builder'[Color]) = 1, "BLACK",
			    MAX('P&L Builder'[Color]) = 2, "BLACK"
			)
		lineageTag: c821b953-4a2c-417d-826f-c5d99b6268e3

