			MAX('P&L Builder'[Account_ID])=2002,FORMAT(IFERROR(CALCULATE([LY MTD Actuals],FILTER(ALL('P&L Builder'),'P&L Builder'[Contribution Profit] =1)) / CALCULATE([LY MTD Actuals],FILTER(ALL('P&L Builder'),'P&L Builder'[Revenue] =1)),0),"0.0%"),
			
