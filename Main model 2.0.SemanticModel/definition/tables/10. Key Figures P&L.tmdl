	measure 'LY MTD Actuals P&L' = ```
			SWITCH(TRUE(),  
			
			 MAX('P&L Builder'[Account_ID])=1001,CALCULATE([LY MTD Actuals],FILTER(ALL('P&L Builder'),'P&L Builder'[Gross Profit] = 1)),
			 MAX('P&L Builder'[Account_ID])=1002,FORMAT(IFERROR(CALCULATE([LY MTD Actuals],FILTER(ALL('P&L Builder'),'P&L Builder'[Gross Profit] =1)) / CALCULATE([LY MTD Actuals],FILTER(ALL('P&L Builder'),'P&L Builder'[Revenue] =1)),0),"0.0%"),
			
