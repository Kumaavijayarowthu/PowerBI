		sourceColumn: [Weekly Year Month]

		annotation SummarizationSetBy = Automatic

	partition '00. DateTable' = calculated
		mode: import
		source = ```
				
				VAR FirstFiscalMonth = 7
				VAR WorkingDays = { 2, 3, 4, 5, 6 }
				VAR FirstTransactionDate =
				    MIN ( MIN ( MAIN[Posting Date] ), MIN ( MAIN[Posting Date] ) )
				VAR LastTransactionDate =
				    MAX ( MAX ( MAIN[Posting Date] ), MAX ( OPPORTUNITIES_QUOTES[Expected Delivery Date] ) )
				VAR StartDate =
				    DATE ( YEAR ( FirstTransactionDate ), 1, 1 )
				VAR EndDate =
				    DATE ( YEAR ( LastTransactionDate ) + ( FirstFiscalMonth > 1 ), 12, 31 )
				VAR AllDates =
				    CALENDAR ( StartDate, EndDate )
				VAR GregorianCalendar =
				    ADDCOLUMNS (
				        AllDates,
				        "Day", DAY ( [Date] ),
				        "Month", FORMAT ( [Date], "mmm" ),
				        "Month Number", MONTH ( [Date] ),
				        "Year Month", FORMAT ( [Date], "mmm YYYY" ),
				        "Year Month Number", 
				                YEAR ( [Date] ) * 12 + MONTH ( [Date] ),
				        "Year", YEAR ( [Date] ),
				        "Year Quarter",
				            YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
				        "Year Quarter Number",
				            YEAR ( [Date] ) * 4 + QUARTER ( [Date] ),
				        "Quarter", "Q" & QUARTER ( [Date] ),
				        "Quarter Number", QUARTER ( [Date] ),
				        "Day of Week Number", WEEKDAY ( [Date] ),
				        "Day of Week", FORMAT ( [Date], "ddd" ),
				        "IsWorkingDay", WEEKDAY ( [Date] ) IN WorkingDays
				    )
				VAR WeeklyCalendar =
				    GENERATEALL (
				        AllDates,
				        VAR WeeksInM1 = 4
				        VAR WeeksInM2 = 4
				        VAR WeeksInM3 = 5
				        VAR YearNumber = YEAR ( [Date] )
				        VAR WeekNumber = 
				            IF ( 
				                WEEKNUM ( [Date] ) = 53,
				                IF ( WEEKDAY ( DATE ( YearNumber, 12, 31 ) ) = 7, 53, 1 ),
				                WEEKNUM ( [Date] )
				            )
				        VAR MonthNumber = MONTH ( [Date] )
				        VAR WeeklyYear =
				            IF ( WeekNumber = 1 && MonthNumber = 12, YearNumber + 1, YearNumber )
				        VAR QuarterNumber =
				            IF ( WeekNumber > 52, 4, INT ( ROUNDUP ( WeekNumber / 13, 0 ) ) )
				        VAR WeekInQuarter =
				            IF ( WeekNumber > 52, 14, WeekNumber - 13 * ( QuarterNumber - 1 ) )
				        VAR WeeklyMonthNumber =
				            ( QuarterNumber - 1 ) * 3
				                + SWITCH (
				                    TRUE,
				                    WeekInQuarter <= WeeksInM1, 1,
				                    WeekInQuarter <= WeeksInM1 + WeeksInM2, 2,
				                    3
				                )
				        RETURN
				            ROW (
				                "Week", "W " & WeekNumber,
				                "Week Number", WeekNumber,
				                "Year Week",
				                    "WY " & WeeklyYear & " W" & WeekNumber,
				                "Year Week Number",
				                    WeeklyYear * 100 + WeekNumber,
				                "Weekly Year", "WY  " & WeeklyYear,
				                "Weekly Quarter", "WQ" & QuarterNumber,
				                "Weekly Quarter Number", QuarterNumber,
				                "Weekly Year Quarter",
				                    "WY " & WeeklyYear & " WQ" & QuarterNumber,
				                "Weekly Year Quarter Number",
				                    WeeklyYear * 100 + QuarterNumber,
				                "Weekly Month Number", WeeklyMonthNumber,
				                "Weekly Month", "WM " & WeeklyMonthNumber,
				                "Weekly Year Month Number",
				                    WeeklyYear * 100 + WeeklyMonthNumber,
				                "Weekly Year Month",
				                    "WY " & WeeklyYear & " WM" & WeeklyMonthNumber
				            )
				    )
				RETURN
				        NATURALLEFTOUTERJOIN (
				            GregorianCalendar, 
				            WeeklyCalendar
				        )
				```

	annotation PBI_Id = 0cacd1b2abc04ef2a236a629ce599cbc

